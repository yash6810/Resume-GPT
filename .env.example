# ResumeGPT Environment Configuration Template
# Copy this file to .env and configure your production credentials.

# Application Environment (development | production)
ENVIRONMENT=development
PORT=8000
DEBUG=False

# JWT Secret Key (REQUIRED in production - min 32 chars)
# Generate with: openssl rand -hex 32
JWT_SECRET=your_32_character_minimum_random_secret_here

# Database Configuration (PostgreSQL in production, SQLite in local dev)
# DATABASE_URL=postgresql://user:password@localhost:5432/resumegpt

# Stripe Payment Processing (Optional for local testing, required for live billing)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO_MONTHLY=price_...

# AI / LLM Configuration
# GEMINI_API_KEY=AIzaSy...
